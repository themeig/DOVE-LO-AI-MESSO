# ==============================================================================
# DOVE LO AI MESSO - Configurazione Variabili d'Ambiente
# ==============================================================================
# Rinomina questo file in .env nella cartella principale del progetto:
#   copy .env.example .env (Windows) oppure cp .env.example .env (Linux/macOS)

# 1. API Key di OpenRouter (Necessaria per l'assistente AI e l'estrazione intelligente)
# Ottienila gratuitamente o ricaricando credito su: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-inserisci-qui-la-tua-chiave-openrouter

# 2. Modello AI preferito su OpenRouter (Opzionale, default: google/gemini-2.5-flash-lite)
# Alcuni modelli supportati consigliati:
# - google/gemini-2.5-flash-lite (Veloce ed economico - Consigliato)
# - google/gemini-2.5-pro (Massima precisione)
# - anthropic/claude-3.5-sonnet
# - openai/gpt-4o-mini
OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# 3. Google Gemini API Key (Opzionale / Alternativa diretta)
GEMINI_API_KEY=

# 4. Integrazione Google Drive (OAuth 2.0 Cloud Storage)
# Ottienili da Google Cloud Console -> Credenziali -> ID client OAuth 2.0 (Applicazione Web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:8000/api/drive/callback

# 5. Modalità Debug (True / False)
DEBUG=True

